{
  "name": "danceform-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "export:android": "expo export --platform android --output-dir ../../dist/mobile-android",
    "export:ios": "expo export --platform ios --output-dir ../../dist/mobile-ios"
  },
  "dependencies": {
    "expo": "~58.0.26",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "expo-status-bar": "~58.0.5",
    "expo-screen-orientation": "~58.0.4",
    "expo-secure-store": "~58.0.3",
    "expo-audio": "~58.0.12",
    "react-native-svg": "15.16.0",
    "react-native-safe-area-context": "~5.11.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@expo/fingerprint": {
      "minimatch": "^11.0.1"
    }
  }
}
